filters:
  and:
    - file.ext == "md"
    - file.inFolder("01_产品档案")
    - note["记录类型"] == "产品"
formulas:
  产品配件包装: 'link(file.path + "#配件与包装参数", "查看配件与箱规")'
properties:
  formula.产品配件包装:
    displayName: 配件与包装参数
  file.name:
    displayName: 产品型号
  note.优先阅读规格:
    displayName: 技术参数
  note.国外包装:
    displayName: 包装资料
  note.阅读分组:
    displayName: 阅读分组
views:
  - type: table
    name: 首页产品
    groupBy:
      property: 阅读分组
      direction: ASC
    order:
      - file.name
      - 品类
      - 优先阅读规格
      - 国外包装
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 国外优先
    filters:
      and:
        - note["阅读分组"] == "国外优先"
    order:
      - file.name
      - 品类
      - 优先阅读规格
      - 国外包装
  - type: table
    name: 运动相机
    filters:
      and:
        - note["品类"] == "运动相机"
    order:
      - file.name
      - 优先阅读规格
      - 国外包装
      - 阅读分组
  - type: cards
    name: 产品画册
    image: note.产品图片
    imageFit: contain
    order:
      - file.name
      - 品类
      - 优先阅读规格
      - 国外包装
  - type: table
    name: 按品类查看
    groupBy:
      property: 品类
      direction: ASC
    order:
      - file.name
      - 优先阅读规格
      - 更新日期
  - type: table
    name: 资料完整度
    order:
      - file.name
      - 基础档案完整度
      - 技术参数完整度
      - 规格版本完整度
      - BOM完整度
      - 包装信息完整度
      - 报价完整度
      - 认证资料完整度
      - 重要备注完整度
  - type: table
    name: 资料缺失与待核实
    filters:
      or:
        - note["资料完整度"] != "已完成"
        - note["存在待核实"] == true
    order:
      - file.name
      - 资料完整度
      - BOM完整度
      - 报价完整度
      - 认证资料完整度
  - type: table
    name: 当前产品完整度
    filters:
      and:
        - file.name == this.file.name
    order:
      - 基础档案完整度
      - 技术参数完整度
      - 规格版本完整度
      - BOM完整度
      - 包装信息完整度
      - 报价完整度
      - 认证资料完整度
      - 重要备注完整度

  - type: table
    name: 配件与包装
    order:
      - file.name
      - 品类
      - formula.产品配件包装
      - 国外包装
    sort:
      - property: file.name
        direction: ASC
